# Copy to .env.local for local development. Never commit real values.
# In Vercel these are set per environment (Preview → staging, Production → production).

# Supabase → Project Settings → API Keys (publishable key) and General (project ID)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# local | staging | production — shown on the status card
NEXT_PUBLIC_APP_ENV=local

# Server-only secrets (used from Phase 3 onwards; leave blank for now)
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
